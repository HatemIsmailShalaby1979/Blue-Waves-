# Blue Waves v0.3.0 Configuration

# Tenant
BLUE_WAVES_TENANT_ID=bluewaves
BLUE_WAVES_OWNER_ACTOR=hatem

# Data
BLUE_WAVES_DATA_DIR=data

# Secrets-at-rest encryption master password (required to encrypt stored secrets)
# WARNING: never commit a real value. If unset, secrets are stored in plaintext.
BLUE_WAVES_MASTER_PASSWORD=

# Limits
BLUE_WAVES_MAX_WEEKLY_PUBLISHES=5
BLUE_WAVES_MONTHLY_CLOUD_CENTS=0
BLUE_WAVES_MAX_WEEKLY_MUSIC=20
BLUE_WAVES_MAX_WEEKLY_PODCASTS=5
BLUE_WAVES_MAX_WEEKLY_VIDEOS=10
BLUE_WAVES_MAX_PODCAST_DURATION_MINUTES=60
BLUE_WAVES_MAX_MUSIC_DURATION_SECONDS=600
BLUE_WAVES_AUTO_APPROVE_UNDER_CENTS=0

# Local LLM
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Cloud LLM
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=

NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=

# Codex
BLUE_WAVES_CODEX_BASE_URL=
BLUE_WAVES_CODEX_API_KEY=

# Media tools
FFMPEG_BIN=ffmpeg
PIPER_BIN=piper
EDGE_TTS_BIN=edge-tts
ACE_STEP_BIN=
COMFYUI_BASE_URL=

# Music providers (only use documented, owner-approved APIs; free web tiers are not automated)
# Suno offers NO public API key — its free quota lives in the web account and cannot
# be consumed here. Leave SUNO_API_KEY empty; cloud music routes via aimlapi below.
SUNO_API_KEY=
SUNO_BASE_URL=https://api.suno.ai/v1
MODELSCOPE_API_KEY=
HUGGINGFACE_MEDIA_TOKEN=

# ElevenLabs — TTS (natural voices for podcasts), Scribe (speech-to-text for video-use)
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# video-use integration (post-production video editing)
VIDEO_USE_ENABLED=true
VIDEO_USE_SKILL_PATH=vendor/video_use/SKILL.md

# Quality enhancement
ENHANCEMENT_ENABLED=true
ENHANCEMENT_PROFILE=balanced
PROVIDER_ROTATION_PATH=provider_rotation.json

# Video providers
KLING_API_KEY=
KLING_BASE_URL=https://api.klingai.com/v1
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://api.seedance.com/v1

# TTS providers
# Kokoro needs NO account/key when self-hosted:
#   docker run -p 8880:8880 --name kokoro-tts-cpu ghcr.io/remsky/kokoro-fastapi-cpu:v0.2.2
# then set KOKORO_BASE_URL=http://localhost:8880/v1 and leave KOKORO_API_KEY empty.
# A hosted Kokoro endpoint still needs its API key.
KOKORO_API_KEY=
KOKORO_BASE_URL=https://api.kokoro.dev/v1
GOOGLE_TTS_CREDENTIALS_PATH=

# Publishing
YOUTUBE_CHANNEL_ID=
YOUTUBE_UPLOAD_ENABLED=false
# OAuth client ID/secret are normally entered in the Cockpit connection panel.
# Do not commit real credentials to this file.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
PODCAST_PUBLISH_ENABLED=false
MUSIC_PUBLISH_ENABLED=false

# Cockpit
COCKPIT_HOST=127.0.0.1
COCKPIT_PORT=8420
COCKPIT_SECRET_KEY=change-me-in-production
COCKPIT_USERNAME=hatem
COCKPIT_PASSWORD_HASH=
# Public base URL used when generating podcast RSS enclosure links (e.g. https://podcasts.example.com)
COCKPIT_PUBLIC_BASE_URL=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_MAX_CONCURRENT=3

# Quality
PROVIDER_FALLBACK_ENABLED=true
QUALITY_GATE_THRESHOLD=0.7
